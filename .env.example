# ── GitHub (host only — never enters the container) ────────────────────────
# Fine-grained PAT. Permissions: Contents=read, Pull requests=read+write,
# Commit statuses=read, Metadata=read. Full walkthrough in SETUP.md.
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# GitHub Enterprise only. Leave as-is for github.com.
GITHUB_HOST=github.com

# Lets you pass a bare PR number instead of a full URL.
DEFAULT_REPO=

# ── Claude (container only — never touches GitHub) ─────────────────────────
# Uses your Claude Max/Pro subscription instead of API credits.
# Generate with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Fallback if you would rather bill the API. Only one of the two is needed.
ANTHROPIC_API_KEY=

# ── Watch mode (node watch.js) ─────────────────────────────────────────────
# Comma-separated owner/repo or repository URLs, polled every minute.
WATCH_REPOS=
# Reviews running at once. Each holds CONTAINER_MEMORY and CONTAINER_CPUS.
WATCH_CONCURRENCY=2
# true: review again when a reviewed PR gets new commits. false: review once.
WATCH_ON_NEW_COMMITS=true

# ── Telegram (optional, host only) ─────────────────────────────────────────
# Review started / finished / failed, and merges in watch mode.
# Bot token from @BotFather. Chat id: a channel like -1001234567890, or @name.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Behaviour ──────────────────────────────────────────────────────────────
REVIEW_IMAGE=pr-review-agent:latest
REVIEW_MODEL=claude-opus-4-6
MAX_TURNS=40
CONTAINER_TIMEOUT_MS=900000
CONTAINER_MEMORY=4g
CONTAINER_CPUS=2
MAX_INLINE_COMMENTS=15
MAX_CHANGED_FILES=300
